# Copy to .env (same directory as docker-compose.yml) and fill in real
# values. .env should be gitignored -- never commit real API keys.
#
# NOTE on the two *_API_KEY variables below: docker-compose.yml marks them
# required (${VAR:?...}), and Compose validates that ALL required vars are
# non-empty just to parse the file -- even for commands targeting only the
# backend service (e.g. `docker compose exec backend ...`). If you haven't
# generated real keys yet (see CLOUD_DEPLOY.md step 4), set a temporary
# placeholder like "pending" for both so you can start the backend and
# generate real keys, then come back and replace the placeholders.

# Absolute path on the HOST to the real photo library. Mounted read-only
# into the backend container at /photos_root.
PHOTOSHARE_PHOTOS_ROOT=/mnt/photos

# Absolute path on the HOST for the backend's persistent cache/metadata
# store (SQLite credential store + thumbnails). Mounted read-write into
# the backend container at /var/lib/photoshare/cache. Must persist across
# redeploys -- API keys issued via create-api-key live here, and losing
# this path means regenerating and re-issuing every key. The backend runs
# as uid 1000, so this path needs to be writable by that uid.
PHOTOSHARE_CACHE_ROOT=/opt/photoshare/cache

# Absolute path on the HOST for the backend's rescan/operation logs.
# Mounted read-write into the backend container at /var/log/photoshare.
# Same uid 1000 write-access requirement as PHOTOSHARE_CACHE_ROOT above.
PHOTOSHARE_LOG_ROOT=/opt/photoshare/logs

# Data-plane proxy's PhotoShare API key (create via the backend's
# `python -m photoshare.cli.manage --config config.prod.yaml create-api-key
# --label "data-proxy"`). Must be different from ADMIN_PROXY_API_KEY below
# so the two planes can be rotated/revoked independently, even though the
# backend currently accepts either key on either route group (restricting
# each key to its own route group is an open follow-up).
GALLERY_PROXY_API_KEY=

# Origins allowed to call the data-plane proxy via CORS. Leave empty if
# Apache2 always reverse-proxies the frontend and this proxy under the same
# origin (the recommended production setup) -- CORS only matters when a
# browser calls this proxy from a different origin than the one serving the
# frontend HTML. Comma-separated if more than one, e.g.:
# GALLERY_PROXY_CORS_ORIGINS=https://gallery.example.com
GALLERY_PROXY_CORS_ORIGINS=

# Site name shown in share-link previews (the small card chat apps draw for
# a shared album or photo). Leave empty for the default, "My Dynamic
# Gallery".
GALLERY_PROXY_SITE_NAME=

# Admin-plane proxy's PhotoShare API key (create the same way, with a
# distinct --label, e.g. "admin-proxy"). Must differ from
# GALLERY_PROXY_API_KEY above.
ADMIN_PROXY_API_KEY=

# Origins allowed to call the admin-plane proxy via CORS. Same reasoning as
# GALLERY_PROXY_CORS_ORIGINS above, but for the admin frontend's origin,
# e.g.:
# ADMIN_PROXY_CORS_ORIGINS=https://admin.example.com
ADMIN_PROXY_CORS_ORIGINS=
